<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rt_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/logo_background"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/rt_text_white"
            android:textSize="60sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Order Confirmed!"
            android:textColor="@color/rt_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Thank you for choosing RT Halaal Catering."
            android:textColor="@color/rt_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvOrderNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:padding="18dp"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:text="Order Reference: RT-10001"
            android:textColor="@color/rt_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:text="Order details"
            android:textColor="@color/rt_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPaymentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:text="Payment details"
            android:textColor="@color/rt_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:text="BACK TO HOME"
            android:textColor="@color/rt_text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/rt_primary" />

        <Button
            android:id="@+id/btnViewOrders"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="VIEW MY ORDERS"
            android:textColor="@color/rt_primary"
            android:textSize="15sp"
            android:background="@drawable/button_outline_background" />

    </LinearLayout>

</ScrollView>