<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background">

    <TextView
        android:id="@+id/tvCartProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Milk Tart"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/rt_text_primary" />

    <TextView
        android:id="@+id/tvCartCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Sweet Treats"
        android:textSize="13sp"
        android:textColor="@color/rt_primary" />

    <TextView
        android:id="@+id/tvCartPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="R 5.00 each"
        android:textSize="14sp"
        android:textColor="@color/rt_text_secondary" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity:"
            android:textSize="14sp"
            android:textColor="@color/rt_text_primary" />

        <EditText
            android:id="@+id/etCartQuantity"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:inputType="number"
            android:gravity="center"
            android:text="20"
            android:background="@drawable/button_outline_background" />

        <Button
            android:id="@+id/btnUpdateQuantity"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="UPDATE"
            android:textSize="12sp"
            android:textColor="@color/rt_text_white"
            android:backgroundTint="@color/rt_primary" />

    </LinearLayout>


    <TextView
        android:id="@+id/tvCartSubtotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Subtotal: R 100.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/rt_primary" />


    <Button
        android:id="@+id/btnRemove"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="5dp"
        android:text="REMOVE"
        android:textSize="12sp"
        android:textColor="@color/rt_error"
        android:background="@android:color/transparent" />

</LinearLayout>